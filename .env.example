# 공공데이터 API 키 (키 발급 후 .env 로 복사해서 값 채우기)
# ------------------------------------------------------------------
# 1) 소상공인시장진흥공단_상가(상권)정보  (전국 상가 POI + 업종분류)
#    발급: https://www.data.go.kr/data/15012005/openapi.do
SANGGA_SERVICE_KEY=

# 2) 지방행정 인허가데이터 (개·폐업 → 업종 생존기간)
#    발급: https://www.localdata.go.kr/datamap/main.do  (오픈API)
LOCALDATA_SERVICE_KEY=

# 3) 통계청 SGIS (인구/가구/소득 집계구 단위)
#    발급: https://sgis.kostat.go.kr/developer/html/main.html
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
