# 공공데이터 API 키 (키 발급 후 .env 로 복사해서 값 채우기)
# ------------------------------------------------------------------
# 1) 소상공인시장진흥공단_상가(상권)정보 API (전국 상가 POI + 업종분류)
#    발급: https://www.data.go.kr/data/15012005/openapi.do  → 활용신청(즉시~2시간)
#    ★ '일반 인증키(Decoding)' 값을 넣으세요 (Encoding 키 X — 이중 인코딩됨)
#    ★ 클라우드: 환경변수 SANGGA_SERVICE_KEY + 허용도메인 apis.data.go.kr 둘 다 필요
SANGGA_SERVICE_KEY=

# 2) 지방행정 인허가데이터 (개·폐업 → 업종 생존기간)
#    발급: https://www.localdata.go.kr/datamap/main.do  (오픈API)
LOCALDATA_SERVICE_KEY=

# 3) 통계청 SGIS (인구/가구/소득 집계구 단위)
#    발급: https://sgis.kostat.go.kr/developer/html/main.html
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# 4) 주소 → 좌표 지오코딩 (--address 사용 시). 둘 중 하나만 있으면 됨
#    카카오: https://developers.kakao.com (REST API 키)
KAKAO_REST_KEY=
#    국토부 VWorld: https://www.vworld.kr/dev/v4api.do
VWORLD_KEY=
